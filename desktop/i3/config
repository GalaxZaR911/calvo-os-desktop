# ======================================
# CaLvo.OS Desktop - Configuracion i3
# ======================================

# Tecla principal: Windows/Super
set $mod Mod4

# Colores oficiales
set $bg       #101820
set $panel    #202D3A
set $accent   #56B4FF
set $text     #F2F6FA

# Fuente
font pango:monospace 10

# Terminal
set $terminal xterm
bindsym $mod+Return exec $terminal

# Cerrar ventana
bindsym $mod+Shift+q kill

# Moverse entre ventanas
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Cambiar disposicion
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

# Espacios de trabajo
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

# Mover ventanas entre espacios
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

# Bordes y colores
default_border pixel 2
client.focused          $accent $accent $bg $accent $accent
client.unfocused        $panel $panel $text $panel $panel

# Reiniciar configuracion
bindsym $mod+Shift+r restart

# Salir de i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Salir de CaLvo.OS?' -B 'Salir' 'i3-msg exit'"

# ======================================
# CaLvo.OS - Inicio automatico
# ======================================

# Iniciar nuestra barra personalizada
exec --no-startup-id $HOME/.config/i3/start-polybar.sh

# ======================================
# CaLvo.OS - Fondo de pantalla
# ======================================

# Cargar el fondo oficial al iniciar i3
exec --no-startup-id $HOME/.config/i3/start-wallpaper.sh

# Centro de operaciones calvas
bindsym $mod+d exec --no-startup-id rofi -show drun
